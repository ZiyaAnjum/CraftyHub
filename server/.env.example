NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/fouzas?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-xxxxxxxx
# Exact origin of the frontend (no trailing slash). Must start with https:// in production!
CLIENT_ORIGIN=http://localhost:5173
# Optional public canonical URL for OpenGraph share previews (defaults to CLIENT_ORIGIN if omitted)
PUBLIC_SITE_URL=http://localhost:5173
# Trust proxy depth (1 for Render / Heroku / Vercel single-hop reverse proxy)
TRUST_PROXY=1

# Cookie settings for cross-subdomain or cross-domain hosting:
# COOKIE_DOMAIN=.fouzascreation.com # For shared cookies between app.fouzascreation.com and api.fouzascreation.com
COOKIE_SAMESITE=lax # 'lax' for same-origin/subdomain, 'none' if completely separate origins with credentials

# Cloudinary (image uploads - required in production)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Initial Admin Seeding (npm run seed:admin)
ADMIN_EMAIL=admin@fouzascreation.com
ADMIN_PASSWORD=AdminSecurePassword123!
